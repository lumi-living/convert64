---
source: crates/convert64-formats/tests/asm_emit.rs
expression: "source(\"portrait\", BitmapFormat::Koala, asm, DataStyle::IncludePicture)"
---
// portrait: multicolor bitmap, Koala layout, generated by Convert64.
//   $6000  bitmap      8000 bytes
//   $7f40  screen      1000 bytes
//   $8328  colour      1000 bytes
//   $8710  background     1 byte
// Assemble: java -jar KickAss.jar portrait.asm -o portrait.kla
// portrait.prg is then portrait.kla byte for byte.

.const PORTRAIT_LOAD_ADDRESS = $6000
.const PORTRAIT_BITMAP_SIZE = 8000
.const PORTRAIT_SCREEN_SIZE = 1000
.const PORTRAIT_COLOUR_SIZE = 1000
.const PORTRAIT_BACKGROUND_SIZE = 1
.const PORTRAIT_BACKGROUND_COLOUR = $00

* = $6000 "portrait"
portrait_bitmap:
    .import c64 "portrait.kla"
.label portrait_screen = portrait_bitmap + 8000
.label portrait_colour = portrait_bitmap + 9000
.label portrait_background = portrait_bitmap + 10000
