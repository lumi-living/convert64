---
source: crates/convert64-formats/tests/asm_emit.rs
expression: "source(\"portrait\", BitmapFormat::Koala, asm, DataStyle::IncludeRaw)"
---
; portrait: multicolor bitmap, Koala layout, generated by Convert64.
;   $6000  bitmap      8000 bytes
;   $7f40  screen      1000 bytes
;   $8328  colour      1000 bytes
;   $8710  background     1 byte
; The data is in segment "PORTRAIT"; link it at $6000, e.g. with
;   MEMORY { PIC: start = $6000, size = $2711, file = %O; }
;   SEGMENTS { PORTRAIT: load = PIC, type = ro; }

PORTRAIT_LOAD_ADDRESS = $6000
PORTRAIT_BITMAP_SIZE = 8000
PORTRAIT_SCREEN_SIZE = 1000
PORTRAIT_COLOUR_SIZE = 1000
PORTRAIT_BACKGROUND_SIZE = 1
PORTRAIT_BACKGROUND_COLOUR = $00

.segment "PORTRAIT"
portrait_bitmap:
    .incbin "portrait.bitmap.bin"
portrait_screen:
    .incbin "portrait.screen.bin"
portrait_colour:
    .incbin "portrait.colour.bin"
portrait_background:
    .incbin "portrait.bg.bin"
